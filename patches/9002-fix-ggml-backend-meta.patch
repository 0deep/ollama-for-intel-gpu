From cdf8e3bb903b51e96921087d855fe5924feb0846 Mon Sep 17 00:00:00 2001
From: 0deep <kimexpon@gmail.com>
Date: Sun, 12 Apr 2026 22:22:30 +0900
Subject: [PATCH] fix: add batch size hint to ggml-backend-meta

---
 ggml/src/ggml-backend-meta.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-backend-meta.cpp b/ggml/src/ggml-backend-meta.cpp
index a2ab8872c..9a075bca0 100644
--- a/ggml/src/ggml-backend-meta.cpp
+++ b/ggml/src/ggml-backend-meta.cpp
@@ -1550,7 +1550,7 @@ static void ggml_backend_meta_synchronize(ggml_backend_t backend) {
     }
 }
 
-static enum ggml_status ggml_backend_meta_graph_compute(ggml_backend_t backend, struct ggml_cgraph * cgraph) {
+static enum ggml_status ggml_backend_meta_graph_compute(ggml_backend_t backend, struct ggml_cgraph * cgraph, int batch_size) {
     GGML_ASSERT(cgraph->grads == nullptr);
     const size_t n_backends = ggml_backend_meta_n_backends(backend);
     ggml_backend_meta_context * backend_ctx = (ggml_backend_meta_context *) backend->context;
@@ -1827,7 +1827,7 @@ static enum ggml_status ggml_backend_meta_graph_compute(ggml_backend_t backend,
                     continue;
                 }
                 auto & bcj = backend_ctx->backend_configs[j];
-                const ggml_status status = ggml_backend_graph_compute_async(bcj.backend, step_cgraphs[j]);
+                const ggml_status status = ggml_backend_graph_compute_async(bcj.backend, step_cgraphs[j], batch_size);
                 if (status != GGML_STATUS_SUCCESS) {
                     return status;
                 }
@@ -1840,7 +1840,7 @@ static enum ggml_status ggml_backend_meta_graph_compute(ggml_backend_t backend,
     for (size_t i = 0; i < n_subgraphs; i++) {
         for (size_t j = 0; j < n_backends; j++) {
             auto & bcj = backend_ctx->backend_configs[j];
-            const ggml_status status = ggml_backend_graph_compute_async(bcj.backend, bcj.cgraphs[i].cgraph_main);
+            const ggml_status status = ggml_backend_graph_compute_async(bcj.backend, bcj.cgraphs[i].cgraph_main, batch_size);
             if (status != GGML_STATUS_SUCCESS) {
                 return status;
             }
-- 
